[Unit]
Description=Keep the time-lapse picker handle near the current time of day

[Timer]
# Hourly. The handle is a still, so all this buys is that the picker shows
# roughly the current time of day rather than always 07:00. Each refresh gives
# the handle a new mtime, which makes Omarchy's picker generate a new thumbnail
# -- and that cache has no eviction -- so widen this interval if the cache
# matters more than a slightly stale handle.
OnCalendar=*-*-* *:00:00
AccuracySec=1min

[Install]
WantedBy=timers.target
